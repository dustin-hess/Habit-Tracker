<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Habit_Tracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Habit_Tracker"
    xmlns:views="clr-namespace:Habit_Tracker.Views"
    Title="Habit_Tracker">

    <TabBar>
        
        <ShellContent
            Title="Kalender"
            Icon="splash.png"
            ContentTemplate="{DataTemplate views:CalendarPage}"
            Route="CalendarPage" />

        <ShellContent
            Title="Statistik"
            Icon="stats_icon.png"
            
            Route="SecondPage" />
        <!-- ContentTemplate="{DataTemplate views:SecondPage}" -->
    </TabBar>
</Shell>
